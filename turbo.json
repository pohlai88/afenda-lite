{
	"$schema": "https://turbo.build/schema.json",
	"globalPassThroughEnv": [
		"DATABASE_URL",
		"NEON_AUTH_BASE_URL",
		"NEON_AUTH_COOKIE_SECRET",
		"APP_URL",
		"NEON_ORG_ID",
		"NEON_PROJECT_ID",
		"NEON_BRANCH_ID",
		"NEON_API_KEY",
		"PORTAL_ORG_SLUG",
		"PORTAL_ORG_NAME",
		"PORTAL_ORG_SWITCHER_ENABLED",
		"PORTAL_ORGANIZATION_ID",
		"E2E_ORGANIZATION_ID",
		"GUARDIAN_AUTH_SHELL",
		"RESEND_API_KEY",
		"SHARED_ADMIN_EMAIL",
		"SHARED_ADMIN_NAME",
		"SHARED_ADMIN_PASSWORD",
		"PREVIEW_CLIENT_EMAIL",
		"PREVIEW_CLIENT_NAME",
		"PREVIEW_CLIENT_PASSWORD",
		"CLIENT_DEFAULT_PASSWORD",
		"CHECKLY_API_KEY",
		"CHECKLY_ACCOUNT_ID",
		"ENABLE_EXPERIMENTAL_COREPACK",
		"SKIP_ENV_VALIDATION",
		"VERCEL",
		"VERCEL_ENV",
		"VERCEL_URL",
		"CI",
		"GITHUB_APP_ID",
		"GITHUB_APP_PRIVATE_KEY",
		"DOCS_URL",
		"VERCEL_DEEP_CLONE"
	],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": [".next/**", "!.next/cache/**", "dist/**"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"lint": {},
		"typecheck": {},
		"test": {
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/testing/vitest.shared.ts",
				"$TURBO_ROOT$/testing/vitest.unit.config.ts",
				"$TURBO_ROOT$/testing/setup-*.ts",
				"$TURBO_ROOT$/testing/empty-server-only.ts"
			],
			"outputs": []
		},
		"test:interaction": {
			"dependsOn": ["^build"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/testing/vitest.shared.ts",
				"$TURBO_ROOT$/testing/vitest.interaction.config.ts",
				"$TURBO_ROOT$/testing/setup-interaction.ts"
			],
			"outputs": []
		},
		"test:stories": {
			"dependsOn": ["^build"],
			"cache": false,
			"outputs": []
		},
		"test:visual": {
			"dependsOn": ["build"],
			"cache": false,
			"outputs": ["playwright-report/**", "test-results/**"]
		},
		"test:parity": {
			"dependsOn": ["^build"],
			"cache": false,
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/testing/vitest.shared.ts",
				"$TURBO_ROOT$/testing/vitest.hr-parity.config.ts",
				"$TURBO_ROOT$/testing/setup-hr-parity-database.ts",
				"$TURBO_ROOT$/testing/vitest.master-data-parity.config.ts",
				"$TURBO_ROOT$/testing/setup-master-data-parity-database.ts",
				"$TURBO_ROOT$/testing/verify-master-data-core-parity-schema.ts",
				"$TURBO_ROOT$/testing/verify-master-data-parity-schema.ts",
				"$TURBO_ROOT$/packages/foundation/testing/src/require-database-for-ci.ts"
			],
			"outputs": []
		},
		"start": {
			"cache": false,
			"persistent": true
		},
		"db:generate": {
			"cache": false
		},
		"db:migrate": {
			"cache": false
		},
		"db:check": {
			"cache": false
		},
		"email:dev": {
			"cache": false,
			"persistent": true
		},
		"clean": {
			"cache": false
		}
	}
}
