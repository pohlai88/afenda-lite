{
	"name": "@afenda/storybook",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "storybook dev --port 6006 --no-open",
		"build": "storybook build --output-dir storybook-static",
		"preview": "vite preview --outDir storybook-static --port 6007",
		"lint": "biome check .",
		"typecheck": "tsc --noEmit -p tsconfig.json && tsc -p .storybook/tsconfig.loader.json",
		"test": "vitest run --config vitest.coverage.config.ts",
		"test:stories": "vitest run --config vitest.storybook.config.ts",
		"test:visual": "pnpm build && playwright test --config playwright.visual.config.ts",
		"test:visual:update": "pnpm build && playwright test --config playwright.visual.config.ts --update-snapshots"
	},
	"dependencies": {
		"@afenda/ui-system": "workspace:*",
		"@fontsource-variable/geist": "5.3.0",
		"@fontsource-variable/geist-mono": "5.3.0",
		"lucide-react": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:",
		"recharts": "catalog:",
		"sonner": "catalog:",
		"tw-animate-css": "catalog:"
	},
	"devDependencies": {
		"@afenda/config": "workspace:*",
		"@axe-core/playwright": "^4.12.1",
		"@playwright/test": "^1.61.1",
		"@storybook/addon-a11y": "10.5.5",
		"@storybook/addon-docs": "10.5.5",
		"@storybook/addon-vitest": "10.5.5",
		"@storybook/react-vite": "10.5.5",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/dom": "10.4.1",
		"@testing-library/jest-dom": "catalog:",
		"@types/node": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"@vitest/browser-playwright": "4.1.10",
		"aria-query": "5.3.2",
		"lz-string": "1.5.0",
		"storybook": "10.5.5",
		"tailwindcss": "^4.3.3",
		"tsx": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:"
	}
}
