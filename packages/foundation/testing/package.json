{
	"name": "@afenda/testing",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "Shared Vitest/Playwright test utilities (dev/test only)",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./require-database-for-ci": {
			"types": "./src/require-database-for-ci.ts",
			"default": "./src/require-database-for-ci.ts"
		},
		"./e2e-database": {
			"types": "./src/e2e-database.ts",
			"default": "./src/e2e-database.ts"
		},
		"./lanes": {
			"types": "./src/lanes.ts",
			"default": "./src/lanes.ts"
		},
		"./setups/database": {
			"types": "./src/setups/database.ts",
			"default": "./src/setups/database.ts"
		},
		"./setups/required-database": {
			"types": "./src/setups/required-database.ts",
			"default": "./src/setups/required-database.ts"
		},
		"./vitest": {
			"types": "./src/define-vitest-config.ts",
			"default": "./src/define-vitest-config.ts"
		},
		"./playwright": {
			"types": "./src/define-playwright-config.ts",
			"default": "./src/define-playwright-config.ts"
		}
	},
	"scripts": {
		"lint": "biome check .",
		"protect:check": "node ../../../.cursor/skills/afenda-package-protection/scripts/protect-package-check.mjs .",
		"protect:update": "node ../../../.cursor/skills/afenda-package-protection/scripts/protect-package-update.mjs .",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"test": "vitest run --config ../../../testing/vitest.unit.config.ts --project testing"
	},
	"devDependencies": {
		"@afenda/config": "workspace:*",
		"@types/node": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
