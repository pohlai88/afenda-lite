{
	"name": "@afenda/testing",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "Shared Vitest/Playwright test utilities (dev/test only)",
	"imports": {
		"#testing/*": "./src/*.ts"
	},
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./setup/database": {
			"types": "./src/entrypoints/setup-database.ts",
			"default": "./src/entrypoints/setup-database.ts"
		},
		"./setup/required-database": {
			"types": "./src/entrypoints/setup-required-database.ts",
			"default": "./src/entrypoints/setup-required-database.ts"
		}
	},
	"scripts": {
		"lint": "biome check .",
		"protect:check": "node ../../../.cursor/skills/afenda-package-protection/scripts/protect-package-check.mjs .",
		"protect:update": "node ../../../.cursor/skills/afenda-package-protection/scripts/protect-package-update.mjs .",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"test": "vitest run --config ../../../testing/vitest.unit.config.ts --project testing"
	},
	"devDependencies": {
		"@afenda/config": "workspace:*",
		"@types/node": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
