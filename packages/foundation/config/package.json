{
	"name": "@afenda/config",
	"version": "0.0.0",
	"private": true,
	"description": "Shared Biome + TypeScript bases. Dev-time only: consumed through `extends`, never imported. Not the Vitest/Playwright factory — see testing/.",
	"exports": {
		"./biome.policy.json": "./biome.policy.json",
		"./tsconfig/base.json": "./tsconfig/base.json",
		"./tsconfig/node-library.json": "./tsconfig/node-library.json",
		"./tsconfig/nextjs.json": "./tsconfig/nextjs.json",
		"./tsconfig/react-library.json": "./tsconfig/react-library.json"
	},
	"scripts": {
		"lint": "biome check .",
		"test": "node scripts/check-config-boundary.mjs && vitest run --config ../../../testing/vitest.unit.config.ts --project config",
