{
	"name": "@afenda/env",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./docs": {
			"types": "./src/docs.ts",
			"default": "./src/docs.ts"
		},
		"./contract": {
			"types": "./src/contract.ts",
			"default": "./src/contract.ts"
		},
		"./performance": {
			"types": "./src/performance.ts",
			"default": "./src/performance.ts"
		},
		"./recovery": {
			"types": "./src/recovery.ts",
			"default": "./src/recovery.ts"
		}
	},
	"scripts": {
		"lint": "biome check .",
		"protect:check": "node ../../../.cursor/skills/afenda-package-protection/scripts/protect-package-check.mjs .",
		"protect:update": "node ../../../.cursor/skills/afenda-package-protection/scripts/protect-package-update.mjs .",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"test": "vitest run --config ../../../testing/vitest.unit.config.ts --project env"
	},
	"dependencies": {
		"@t3-oss/env-nextjs": "^0.13.11",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@afenda/config": "workspace:*",
		"@types/node": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
