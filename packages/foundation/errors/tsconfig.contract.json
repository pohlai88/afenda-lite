{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"rootDir": ".",
		"tsBuildInfoFile": ".turbo/tsconfig.contract.tsbuildinfo"
	},
	"include": [
		"src/**/*.ts",
		"__tests__/type-fixtures/**/*.ts",
		"__tests__/ast-fixtures/allowed/**/*.ts",
		"__tests__/ast-fixtures/allowed/**/*.tsx"
	],
	"exclude": ["node_modules", "dist"]
}
