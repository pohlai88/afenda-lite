{
	"name": "@afenda/master-data",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./adapters/drizzle": {
			"types": "./src/adapters/drizzle.ts",
			"default": "./src/adapters/drizzle.ts"
		},
		"./types": {
			"types": "./src/types.ts",
			"default": "./src/types.ts"
		},
		"./module-manifest": {
			"types": "./src/module.manifest.ts",
			"default": "./src/module.manifest.ts"
		},
		"./platform-references": {
			"types": "./src/capabilities/platform-references/index.ts",
			"default": "./src/capabilities/platform-references/index.ts"
		},
		"./lifecycle-governance": {
			"types": "./src/capabilities/lifecycle-governance/index.ts",
			"default": "./src/capabilities/lifecycle-governance/index.ts"
		},
		"./testing/organization-dimensions": {
			"types": "./src/capabilities/core-organization-masters/testing-organization-dimension-store.ts",
			"default": "./src/capabilities/core-organization-masters/testing-organization-dimension-store.ts"
		}
	},
	"scripts": {
		"lint": "biome check .",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"test": "vitest run --config ../../../testing/vitest.unit.config.ts --project master-data"
	},
	"dependencies": {
		"@afenda/audit": "workspace:*",
		"@afenda/db": "workspace:*",
		"@afenda/errors": "workspace:*",
		"@afenda/events": "workspace:*",
		"@afenda/search": "workspace:*",
		"server-only": "0.0.1",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@afenda/config": "workspace:*",
		"@types/node": "catalog:",
		"typescript": "catalog:"
	}
}
