{
	"name": "@afenda/human-resources",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./testing": {
			"types": "./src/testing/index.ts",
			"default": "./src/testing/index.ts"
		}
	},
	"scripts": {
		"lint": "biome check .",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"test": "vitest run --config ../../../testing/vitest.unit.config.ts --project human-resources-unit",
		"test:benchmark": "node --conditions react-server --import tsx ./src/performance-verification/run-local-benchmarks.ts",
		"test:parity": "vitest run --config ../../../testing/vitest.hr-parity.config.ts --project human-resources-parity",
		"check": "pnpm typecheck && pnpm test"
	},
	"dependencies": {
		"@afenda/audit": "workspace:*",
		"@afenda/db": "workspace:*",
		"@afenda/errors": "workspace:*",
		"@afenda/events": "workspace:*",
		"server-only": "0.0.1",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@afenda/config": "workspace:*",
		"@afenda/payroll": "workspace:*",
		"@afenda/testing": "workspace:*",
		"@types/node": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
