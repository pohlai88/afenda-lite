{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"project": ["src/**/*.{ts,tsx}", "__tests__/**/*.{ts,tsx}"],
	"entry": ["scripts/generate-mutation-inventory.mjs"],
	"vitest": {
		"config": ["../../../testing/vitest.config.ts"]
	},
	"ignoreExportsUsedInFile": true,
	"ignoreIssues": {
		"__tests__/helpers/**": ["exports", "types"],
		"src/**": ["exports", "types"],
		"src/kernel/identity/brands.ts": ["duplicates"],
		"src/features/recruitment/schema.ts": ["duplicates"],
		"src/features/time/schema.ts": ["duplicates"]
	},
	"ignoreDependencies": ["vitest"],
	"ignoreBinaries": ["biome", "vitest"]
}
