{
	"name": "@afenda/corporate-administration",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./module-manifest": {
			"types": "./src/composition/module.manifest.ts",
			"default": "./src/composition/module.manifest.ts"
		},
		"./adapters/drizzle": {
			"types": "./src/composition/adapters/drizzle/index.ts",
			"default": "./src/composition/adapters/drizzle/index.ts"
		},
		"./testing": {
			"types": "./src/testing/index.ts",
			"default": "./src/testing/index.ts"
		}
	},
	"scripts": {
		"check:feature-layout": "node ./scripts/feature-first-layout.mjs",
		"lint": "biome check .",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"test": "vitest run --config ../../../testing/vitest.unit.config.ts --project corporate-administration",
		"test:parity": "vitest run --config ../../../testing/vitest.corporate-administration-parity.config.ts --project corporate-administration-parity",
		"check": "pnpm check:feature-layout && pnpm lint && pnpm typecheck && pnpm test"
	},
	"dependencies": {
		"@afenda/audit": "workspace:*",
		"@afenda/db": "workspace:*",
		"@afenda/errors": "workspace:*",
		"server-only": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@afenda/config": "workspace:*",
		"@afenda/testing": "workspace:*",
		"@types/node": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
