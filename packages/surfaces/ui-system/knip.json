{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"entry": [
		"scripts/**/*.{ts,mts}",
		"__tests__/**/*.{test,spec}.{ts,tsx}",
		"src/metadata/__type-tests__/**/*.type-test.ts"
	],
	"project": ["src/**/*.{ts,tsx}", "__tests__/**/*.{ts,tsx}"],
	"vitest": false,
	"ignoreDependencies": ["tailwindcss"],
	"ignoreBinaries": ["biome"]
}
